name: CI

permissions:
  contents: read

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-24.04
    strategy:
      matrix:
        python-version: [{% if python_version == "3.13" %}"3.13", {% endif %}"3.14"]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{%- if use_uv %}
      - name: Set up uv
        uses: astral-sh/setup-uv@18d369b23da25a81e9458561248e1aafff6a70fa # v10.3.1
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
          enable-cache: true
      - name: Install dependencies
        run: uv sync --locked --group dev
      - name: Lint
        run: uv run --no-sync ruff check .
      - name: Format check
        run: uv run --no-sync ruff format --check .
      - name: Type check
        run: uv run --no-sync ty check .
{%- if framework == "django" %}
      - name: Set Django secret key
        run: echo "DJANGO_SECRET_KEY=$(python -c 'import secrets; print(secrets.token_urlsafe(50))')" >> "$GITHUB_ENV"
{%- endif %}
{%- if with_tests %}
      - name: Test
        run: uv run --no-sync pytest
{%- endif %}
{%- if framework == "django" %}
      - name: Django check
        run: uv run --no-sync python manage.py check
{%- endif %}
{%- else %}
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade "pip>=25.1"
          python -m pip install -e . --group dev
      - name: Lint
        run: ruff check .
      - name: Format check
        run: ruff format --check .
      - name: Type check
        run: ty check .
{%- if framework == "django" %}
      - name: Set Django secret key
        run: echo "DJANGO_SECRET_KEY=$(python -c 'import secrets; print(secrets.token_urlsafe(50))')" >> "$GITHUB_ENV"
{%- endif %}
{%- if with_tests %}
      - name: Test
        run: pytest
{%- endif %}
{%- if framework == "django" %}
      - name: Django check
        run: python manage.py check
{%- endif %}
{%- endif %}
