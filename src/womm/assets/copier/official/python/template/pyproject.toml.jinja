[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
dynamic = ["version"]
description = {{ description | tojson }}
readme = "README.md"
license = "{{ 'LicenseRef-Proprietary' if license == 'proprietary' else license }}"
{%- if author_name %}
authors = [{ name = "{{ author_name }}" }]
maintainers = [{ name = "{{ author_name }}" }]
{%- endif %}
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Topic :: Software Development :: Libraries :: Python Modules",
]
requires-python = ">={{ python_version }}"
dependencies = [
{%- if framework == "django" %}
    "django>=5.2.8",
{%- endif %}
]

[dependency-groups]
dev = [
    "ruff~={{ tool_versions.ruff }}",
{%- if tooling == "black-isort" %}
    "black~={{ tool_versions.black }}",
    "isort~={{ tool_versions.isort }}",
{%- endif %}
    "{{ type_checker }}~={{ tool_versions[type_checker] }}",
    "pre-commit~={{ tool_versions.pre_commit }}",
{%- if with_tests %}
    "pytest~={{ tool_versions.pytest }}",
{%- if with_coverage %}
    "pytest-cov~={{ tool_versions.pytest_cov }}",
{%- endif %}
{%- endif %}
{%- if with_tests and framework == "django" %}
    "pytest-django~={{ tool_versions.pytest_django }}",
{%- endif %}
{%- if framework == "django" %}
    "django-stubs~={{ tool_versions.django_stubs }}",
{%- endif %}
]

[tool.hatch.version]
{%- if use_src_layout %}
path = "src/{{ package_name }}/__init__.py"
{%- else %}
path = "{{ package_name }}/__init__.py"
{%- endif %}

[tool.hatch.build.targets.wheel]
{%- if use_src_layout %}
packages = ["src/{{ package_name }}"]
{%- else %}
packages = ["{{ package_name }}"]
{%- endif %}
{%- if use_uv %}

[tool.uv]
# uv builds and installs this project into its environment.
package = true
{%- endif %}

[tool.ruff]
required-version = "~={{ tool_versions.ruff }}"
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 88

[tool.ruff.lint]
select = ["E", "W", "F", {% if tooling == 'ruff' %}"I", {% endif %}"B", "C4", "UP", "SIM", "N", "ANN", "RUF"]
ignore = ["E501"]

{%- if tooling == "ruff" %}

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true
{%- else %}

[tool.black]
target-version = ["py{{ python_version | replace('.', '') }}"]
line-length = 88

[tool.isort]
profile = "black"
line_length = 88
skip_gitignore = true
{%- endif %}

{%- if type_checker == "ty" %}

[tool.ty.environment]
python-version = "{{ python_version }}"
{%- if use_src_layout %}
root = ["src"]
{%- else %}
root = ["."]
{%- endif %}

[tool.ty.src]
{%- if use_src_layout %}
include = ["src/{{ package_name }}"]
{%- else %}
include = ["{{ package_name }}"]
{%- endif %}
respect-ignore-files = true
{%- elif type_checker == "mypy" %}

[tool.mypy]
python_version = "{{ python_version }}"
files = ["{% if use_src_layout %}src{% else %}{{ package_name }}{% endif %}"]
strict = true
{%- else %}

[tool.pyright]
pythonVersion = "{{ python_version }}"
include = ["{% if use_src_layout %}src{% else %}{{ package_name }}{% endif %}"]
typeCheckingMode = "strict"
venvPath = "."
venv = ".venv"
{%- endif %}
{%- if with_tests %}

[tool.pytest.ini_options]
minversion = "7.0"
addopts = ["--strict-markers", "--strict-config"{% if with_coverage %}, "--cov={{ package_name }}", "--cov-report=term-missing"{% endif %}]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
{%- if framework == "django" %}
DJANGO_SETTINGS_MODULE = "{{ package_name }}.settings"
{%- endif %}
{%- if with_coverage %}

[tool.coverage.run]
{%- if use_src_layout %}
source = ["src/{{ package_name }}"]
{%- else %}
source = ["{{ package_name }}"]
{%- endif %}
branch = true

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]
{%- endif %}
{%- endif %}
