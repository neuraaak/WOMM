{%- set source_entry = ("src/index." if framework == "react" else "src/main.") + ("tsx" if (typescript and framework == "react") else "ts" if typescript else "jsx" if framework == "react" else "js") -%}
{%- set runtime_entry = "dist/main.js" if typescript else source_entry -%}
{%- set use_biome = tooling == "biome" -%}
{%- set deps = [] -%}
{%- set dev_deps = {'@biomejs/biome': tool_versions.biome} if use_biome else {
  '@eslint/js': tool_versions.eslint_js,
  'eslint': tool_versions.eslint,
  'eslint-config-prettier': tool_versions.eslint_config_prettier,
  'globals': tool_versions.globals,
  'prettier': tool_versions.prettier
} -%}
{%- if framework == "react" -%}
{%- set _ = deps.extend(['"react": "^19.2.0"', '"react-dom": "^19.2.0"']) -%}
{%- set _ = dev_deps.update({'@vitejs/plugin-react': tool_versions.vite_plugin_react, 'vite': tool_versions.vite}) -%}
{%- if not use_biome -%}
{%- set _ = dev_deps.update({'eslint-plugin-react-hooks': tool_versions.eslint_plugin_react_hooks}) -%}
{%- endif -%}
{%- elif framework == "vue" -%}
{%- set _ = deps.append('"vue": "^3.5.0"') -%}
{%- set _ = dev_deps.update({
  '@vitejs/plugin-vue': tool_versions.vite_plugin_vue,
  'eslint-plugin-vue': tool_versions.eslint_plugin_vue,
  'vite': tool_versions.vite,
  'vue-eslint-parser': tool_versions.vue_eslint_parser
}) -%}
{%- endif -%}
{%- if typescript -%}
{%- set _ = dev_deps.update({'@types/node': '^24.0.0', 'typescript': tool_versions.typescript}) -%}
{%- if not use_biome -%}
{%- set _ = dev_deps.update({'typescript-eslint': tool_versions.typescript_eslint}) -%}
{%- endif -%}
{%- if framework == "react" -%}
{%- set _ = dev_deps.update({'@types/react': '^19.0.0', '@types/react-dom': '^19.0.0'}) -%}
{%- elif framework == "vue" -%}
{%- set _ = dev_deps.update({'vue-tsc': tool_versions.vue_tsc}) -%}
{%- endif -%}
{%- endif -%}
{%- if with_tests -%}
{%- set _ = dev_deps.update({'vitest': tool_versions.vitest}) -%}
{%- if with_coverage -%}
{%- set _ = dev_deps.update({'@vitest/coverage-v8': tool_versions.vitest}) -%}
{%- endif -%}
{%- endif -%}
{%- if with_knip -%}
{%- set _ = dev_deps.update({'knip': tool_versions.knip}) -%}
{%- endif -%}
{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": {{ description | tojson }},
  "private": true,
  "type": "module",
{%- if author_name %}
  "author": "{{ author_name }}",
{%- endif %}
  "license": "{{ 'UNLICENSED' if license == 'proprietary' else license }}",
{%- if package_manager == "pnpm" %}
  "packageManager": "pnpm@10.0.0",
{%- elif package_manager == "yarn" %}
  "packageManager": "yarn@4.6.0",
{%- elif package_manager == "bun" %}
  "packageManager": "bun@1.2.0",
{%- endif %}
{%- if framework == "none" %}
  "main": "{{ runtime_entry }}",
{%- endif %}
  "scripts": {
{%- if framework in ("react", "vue") %}
    "dev": "vite",
    "build": "{% if typescript and framework == 'vue' %}vue-tsc --noEmit && {% elif typescript %}tsc --noEmit && {% endif %}vite build",
    "preview": "vite preview",
{%- else %}
    "dev": "node {{ source_entry }}",
    "build": "{% if typescript %}tsc -p tsconfig.json{% else %}node --check {{ source_entry }}{% endif %}",
    "start": "node {{ runtime_entry }}",
{%- endif %}
    "lint": "{% if use_biome %}biome lint .{% else %}eslint .{% endif %}",
    "lint:fix": "{% if use_biome %}biome lint --write .{% else %}eslint . --fix{% endif %}",
    "format": "{% if use_biome %}biome format --write .{% else %}prettier --write .{% endif %}",
    "format:check": "{% if use_biome %}biome format .{% else %}prettier --check .{% endif %}"{% if typescript %},
    "type-check": "{% if framework == 'vue' %}vue-tsc{% else %}tsc{% endif %} --noEmit"{% endif %}{% if with_tests %},
    "test": "vitest run",
    "test:watch": "vitest"{% if with_coverage %},
    "test:coverage": "vitest run --coverage"{% endif %}{% endif %}{% if with_knip %},
    "check:unused": "knip"{% endif %}
  },
  "dependencies": {% if deps %}{
{%- for entry in deps %}
    {{ entry }}{% if not loop.last %},{% endif %}
{%- endfor %}
  }{% else %}{}{% endif %},
  "devDependencies": {
{%- for name, version in dev_deps | dictsort %}
    {{ name | tojson }}: {{ (version if (with_coverage and name in ('vitest', '@vitest/coverage-v8')) or name.startswith('@types/') else '~' ~ version) | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
