{%- set run = "npm run" if package_manager == "npm" else package_manager if package_manager in ("pnpm", "yarn") else "bun run" -%}
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-24.04
{%- if package_manager != "bun" %}
    strategy:
      matrix:
        node-version: [24, 26]
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{%- if package_manager == "bun" %}
      - name: Set up Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
{%- else %}
      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: {% raw %}${{ matrix.node-version }}{% endraw %}
          package-manager-cache: false
{%- if package_manager in ("pnpm", "yarn") %}
      - name: Enable Corepack
        run: |
          if ! command -v corepack >/dev/null; then
            npm install --global corepack@0.36.0
          fi
          corepack enable
{%- endif %}
{%- endif %}
      - name: Install dependencies
{%- if package_manager == "npm" %}
        run: npm ci
{%- elif package_manager == "pnpm" %}
        run: pnpm install --frozen-lockfile
{%- elif package_manager == "yarn" %}
        run: yarn install --immutable
{%- else %}
        run: bun install --frozen-lockfile
{%- endif %}
      - name: Format check
        run: {{ run }} format:check
      - name: Lint
        run: {{ run }} lint
{%- if with_knip %}
      - run: {{ run }} check:unused
{%- endif %}
{%- if typescript %}
      - name: Type check
        run: {{ run }} type-check
{%- endif %}
{%- if with_tests %}
      - name: Test
        run: {{ run }} {% if with_coverage %}test:coverage{% else %}test{% endif %}
{%- endif %}
      - name: Build
        run: {{ run }} build
